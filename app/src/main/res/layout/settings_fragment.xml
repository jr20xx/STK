<?xml version="1.0" encoding="utf-8"?>
<layout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>

        <variable
            name="linkOpener"
            type="cu.lt.joe.stk.fragments.SettingsFragment" />
    </data>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/info_fragment_scrollview"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="8dp">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                app:cardCornerRadius="10dp"
                app:cardElevation="1dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_marginTop="8dp"
                        android:layout_marginEnd="8dp"
                        android:text="@string/general_settings_section_header"
                        android:textAppearance="?android:attr/textAppearanceSmall"
                        android:textStyle="bold" />

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/accessibility_service_switch_card"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_marginTop="8dp"
                        android:layout_marginEnd="8dp"
                        android:layout_marginBottom="4dp"
                        android:clickable="true"
                        android:focusable="true"
                        app:cardCornerRadius="8dp"
                        app:cardElevation="5dp"
                        app:contentPadding="8dp"
                        app:strokeWidth="0dp">

                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">

                            <com.google.android.material.materialswitch.MaterialSwitch
                                android:id="@+id/accessibility_service_switch"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_alignParentEnd="true"
                                android:layout_centerVertical="true"
                                android:clickable="false"
                                android:focusable="false" />

                            <TextView
                                android:id="@+id/accessibility_service_toggle_card_header"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_alignParentStart="true"
                                android:layout_toStartOf="@id/accessibility_service_switch"
                                android:singleLine="true"
                                android:text="@string/accessibility_service_switch_header"
                                android:textAppearance="@style/TextAppearance.Material3.TitleMedium" />

                            <TextView
                                android:id="@+id/accessibility_service_toggle_card_description"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_below="@id/accessibility_service_toggle_card_header"
                                android:layout_alignParentStart="true"
                                android:layout_marginTop="4dp"
                                android:layout_toStartOf="@id/accessibility_service_switch"
                                android:text="@string/accessibility_service_switch_description"
                                android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
                                android:textColor="?android:attr/textColorSecondary" />
                        </RelativeLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/reverted_call_prefix_selector_card"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_marginTop="4dp"
                        android:layout_marginEnd="8dp"
                        android:layout_marginBottom="8dp"
                        app:cardCornerRadius="8dp"
                        app:cardElevation="5dp"
                        app:contentPaddingBottom="8dp"
                        app:contentPaddingLeft="8dp"
                        app:contentPaddingTop="8dp"
                        app:strokeWidth="0dp">

                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">

                            <Spinner
                                android:id="@+id/reverted_call_prefix_selector_spinner"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_alignParentEnd="true"
                                android:layout_centerVertical="true"
                                android:background="@null"
                                android:dropDownWidth="wrap_content"
                                android:padding="0dp" />

                            <TextView
                                android:id="@+id/reverted_call_prefix_selector_card_header"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_alignParentStart="true"
                                android:layout_toStartOf="@id/reverted_call_prefix_selector_spinner"
                                android:singleLine="true"
                                android:text="@string/reverted_call_prefix_selector_header"
                                android:textAppearance="@style/TextAppearance.Material3.TitleMedium" />

                            <TextView
                                android:id="@+id/reverted_call_prefix_selector_card_description"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_below="@id/reverted_call_prefix_selector_card_header"
                                android:layout_alignParentStart="true"
                                android:layout_marginTop="4dp"
                                android:layout_toStartOf="@id/reverted_call_prefix_selector_spinner"
                                android:text="@string/reverted_call_prefix_selector_description"
                                android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
                                android:textColor="?android:attr/textColorSecondary" />
                        </RelativeLayout>
                    </com.google.android.material.card.MaterialCardView>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                app:cardCornerRadius="10dp"
                app:cardElevation="1dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_marginTop="8dp"
                        android:layout_marginEnd="8dp"
                        android:text="@string/useful_information_section_header"
                        android:textAppearance="?android:attr/textAppearanceSmall"
                        android:textStyle="bold" />

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_marginTop="8dp"
                        android:layout_marginEnd="8dp"
                        android:layout_marginBottom="4dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:onClick='@{_ -> linkOpener.openExternalLink("https://etecsa.cu/es/preguntas-frecuentes?faq=374")}'
                        app:cardCornerRadius="8dp"
                        app:cardElevation="5dp"
                        app:contentPadding="5dp"
                        app:strokeWidth="0dp">

                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">

                            <ImageView
                                android:id="@+id/balance_recharge_faq_iv"
                                android:layout_width="32dp"
                                android:layout_height="32dp"
                                android:layout_centerVertical="true"
                                android:layout_gravity="center"
                                android:layout_marginEnd="5dp"
                                android:scaleType="centerCrop"
                                app:srcCompat="@drawable/ic_help" />

                            <TextView
                                android:id="@+id/balance_recharge_faq_header"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginBottom="3dp"
                                android:layout_toEndOf="@id/balance_recharge_faq_iv"
                                android:singleLine="true"
                                android:text="@string/balance_recharge_faq_header"
                                android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_below="@id/balance_recharge_faq_header"
                                android:layout_toEndOf="@id/balance_recharge_faq_iv"
                                android:text="@string/balance_recharge_faq_description"
                                android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
                                android:textColor="?android:attr/textColorSecondary" />
                        </RelativeLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_marginTop="4dp"
                        android:layout_marginEnd="8dp"
                        android:layout_marginBottom="8dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:onClick='@{_ -> linkOpener.openExternalLink("https://etecsa.cu/es/preguntas-frecuentes?faq=4781")}'
                        app:cardCornerRadius="8dp"
                        app:cardElevation="5dp"
                        app:contentPadding="5dp"
                        app:strokeWidth="0dp">

                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">

                            <ImageView
                                android:id="@+id/mobile_plans_faq_iv"
                                android:layout_width="32dp"
                                android:layout_height="32dp"
                                android:layout_centerVertical="true"
                                android:layout_gravity="center"
                                android:layout_marginEnd="5dp"
                                android:importantForAccessibility="no"
                                android:scaleType="centerCrop"
                                app:srcCompat="@drawable/ic_help" />

                            <TextView
                                android:id="@+id/mobile_plans_faq_header"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginBottom="3dp"
                                android:layout_toEndOf="@id/mobile_plans_faq_iv"
                                android:singleLine="true"
                                android:text="@string/mobile_plans_faq_header"
                                android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_below="@id/mobile_plans_faq_header"
                                android:layout_toEndOf="@id/mobile_plans_faq_iv"
                                android:text="@string/mobile_plans_faq_description"
                                android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
                                android:textColor="?android:attr/textColorSecondary" />
                        </RelativeLayout>
                    </com.google.android.material.card.MaterialCardView>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                app:cardCornerRadius="10dp"
                app:cardElevation="1dp"
                app:contentPadding="5dp"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_marginTop="8dp"
                        android:layout_marginEnd="8dp"
                        android:text="@string/application_info_section_header"
                        android:textAppearance="?android:attr/textAppearanceSmall"
                        android:textStyle="bold" />

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_margin="8dp"
                        app:cardCornerRadius="8dp"
                        app:cardElevation="5dp"
                        app:contentPadding="5dp"
                        app:strokeWidth="0dp">

                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">

                            <ImageView
                                android:id="@+id/application_icon_iv"
                                android:layout_width="32dp"
                                android:layout_height="32dp"
                                android:layout_centerVertical="true"
                                android:layout_marginEnd="5dp"
                                android:importantForAccessibility="no"
                                android:scaleType="fitCenter"
                                android:src="@drawable/ic_application_icon_monochrome"
                                app:tint="?colorOnSurface" />

                            <TextView
                                android:id="@+id/application_name_tv"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_toEndOf="@id/application_icon_iv"
                                android:text="@string/app_name"
                                android:textAppearance="@style/TextAppearance.Material3.TitleMedium" />

                            <TextView
                                android:id="@+id/application_version_tv"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_below="@id/application_name_tv"
                                android:layout_toEndOf="@id/application_icon_iv"
                                android:text='@{@string/version_label(@string/app_version)}'
                                android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
                                android:textColor="?android:attr/textColorSecondary" />

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_below="@id/application_version_tv"
                                android:layout_toEndOf="@id/application_icon_iv">

                                <com.google.android.material.chip.Chip
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:clickable="true"
                                    android:focusable="true"
                                    android:onClick='@{_ -> linkOpener.openExternalLink("https://t.me/stk_support_channel")}'
                                    android:text="@string/telegram_label"
                                    android:textAppearance="@style/TextAppearance.Material3.BodySmall"
                                    android:textColor="?android:attr/textColorSecondary"
                                    app:chipIcon="@drawable/ic_telegram" />

                                <com.google.android.material.chip.Chip
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="5dp"
                                    android:clickable="true"
                                    android:focusable="true"
                                    android:onClick='@{_ -> linkOpener.openExternalLink("https://github.com/jr20xx/STK")}'
                                    android:text="@string/source_code_label"
                                    android:textAppearance="@style/TextAppearance.Material3.BodySmall"
                                    android:textColor="?android:attr/textColorSecondary"
                                    app:chipIcon="@drawable/ic_github" />
                            </LinearLayout>
                        </RelativeLayout>
                    </com.google.android.material.card.MaterialCardView>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</layout>