<?xml version="1.0" encoding="utf-8"?>
<layout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>

        <variable
            name="crashLog"
            type="cu.lt.joe.stk.objects.CrashLog" />
    </data>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/additional_options_menu_item_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clickable="true"
        android:focusable="true"
        app:cardBackgroundColor="?attr/colorSurfaceContainerHighest"
        app:cardCornerRadius="1dp"
        app:cardElevation="0dp"
        app:contentPadding="10dp"
        app:strokeWidth="0dp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <ImageView
                android:id="@+id/crash_log_icon_iv"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:layout_marginEnd="8dp"
                app:srcCompat="@drawable/ic_crash_log" />

            <TextView
                android:id="@+id/crash_log_date_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignBottom="@id/crash_log_title_tv"
                android:layout_alignParentEnd="true"
                android:singleLine="true"
                android:text="@{crashLog.formattedTimestamp}"
                android:textAppearance="@style/TextAppearance.Material3.LabelMedium" />

            <TextView
                android:id="@+id/crash_log_title_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentTop="true"
                android:layout_toStartOf="@id/crash_log_date_tv"
                android:layout_toEndOf="@id/crash_log_icon_iv"
                android:singleLine="true"
                android:text="@{crashLog.title}"
                android:textAppearance="@style/TextAppearance.Material3.TitleMedium" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@id/crash_log_title_tv"
                android:layout_toEndOf="@id/crash_log_icon_iv"
                android:singleLine="true"
                android:text="@{crashLog.body}"
                android:textAppearance="@style/TextAppearance.Material3.BodyMedium" />
        </RelativeLayout>
    </com.google.android.material.card.MaterialCardView>
</layout>