<?xml version="1.0" encoding="utf-8"?>
<layout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>

        <variable
            name="crashLogItemOption"
            type="cu.lt.joe.stk.objects.crash_log.CrashLogItemOption" />
    </data>

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clickable="true"
        android:focusable="true"
        android:onClickListener="@{crashLogItemOption.onClickListener}"
        app:cardBackgroundColor="?attr/colorSurfaceContainerLow"
        app:cardCornerRadius="1dp"
        app:cardElevation="0dp"
        app:contentPadding="10dp"
        app:strokeWidth="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginEnd="8dp"
                android:drawable="@{crashLogItemOption.iconResId}" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:singleLine="true"
                android:text="@{crashLogItemOption.label}"
                android:textAppearance="@style/TextAppearance.Material3.LabelLarge" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</layout>