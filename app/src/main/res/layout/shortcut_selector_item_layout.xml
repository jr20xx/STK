<?xml version="1.0" encoding="utf-8"?>
<layout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <data>

        <variable
            name="shortcutItem"
            type="cu.lt.joe.stk.objects.ShortcutItem" />
    </data>

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clickable="true"
        android:focusable="true"
        app:cardBackgroundColor="?attr/colorSurfaceContainerHighest"
        app:cardCornerRadius="1dp"
        app:cardElevation="0dp"
        app:contentPadding="12dp"
        app:strokeWidth="0dp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/shortcut_item_icon_iv"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:layout_marginEnd="8dp"
                android:drawable="@{shortcutItem.iconResId}" />

            <TextView
                android:id="@+id/shortcut_item_title_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_toEndOf="@id/shortcut_item_icon_iv"
                android:singleLine="true"
                android:text="@{shortcutItem.longTitle}"
                android:textAppearance="@style/TextAppearance.Material3.TitleMedium" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@id/shortcut_item_title_tv"
                android:layout_toEndOf="@id/shortcut_item_icon_iv"
                android:singleLine="true"
                android:text="@{shortcutItem.dialingNumber}"
                android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
                android:textColor="?android:attr/textColorSecondary" />
        </RelativeLayout>
    </com.google.android.material.card.MaterialCardView>
</layout>